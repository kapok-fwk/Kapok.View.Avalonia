<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <PackageId>Kapok.View.Avalonia</PackageId>
    <Version>0.1.0</Version>
    <Authors>Kapok Framework Community</Authors>
    <RepositoryUrl>https://github.com/kapok-fwk/Kapok.View.Avalonia</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the latest stable line (12.1.x) rather than 11.2.x so this lines up with
         Dock for Avalonia's packages (versioned 12.1.0.1, i.e. built against Avalonia 12.1.x),
         needed starting Phase 3. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Phase 2: the plan's originally flagged risk turned out real, but worse than expected -
         AvaloniaControls.Ribbon(.Desktop) 0.9.9 (SachiHarshitha/Avalonia.Ribbon, last published
         against Avalonia 11.x) restores and *compiles* fine against Avalonia 12.1.1, but
         RibbonWindow's constructor throws System.MissingMethodException at runtime
         (Window.set_ExtendClientAreaChromeHints was removed from Avalonia's own Window class
         between 11.x and 12.x) - confirmed by actually constructing one, not just building.
         Compile-time restore success doesn't prove runtime binary compatibility for a
         netstandard2.0 package built against a specific Avalonia version.
         Fix: tobitege/Avalonia.Ribbon (github.com/tobitege/Avalonia.Ribbon) is an actively
         maintained fork published as AvaloniaControls.Ribbon.Flowery /
         .Desktop.Flowery, whose own nuspec declares Avalonia 12.1.0+ and which was confirmed,
         via a real headless Avalonia app, to construct RibbonWindow/DesktopRibbon without error
         against 12.1.1. Same AvaloniaUI.Ribbon / AvaloniaUI.Ribbon.Desktop namespaces and
         assembly names as the original, so no code besides this package swap was needed. -->
    <PackageReference Include="AvaloniaControls.Ribbon.Flowery" Version="2026.8.13" />
    <PackageReference Include="AvaloniaControls.Ribbon.Desktop.Flowery" Version="2026.8.13" />
    <!-- Phase 4: confirmed via reflection against the real installed package (not assumed from
         the WPF feature list) that column sort/resize/reorder, multi-select SelectedItems,
         Excel-style clipboard copy, and cell/row edit lifecycle hooks are all already native here -
         see the porting plan's Phase 4 audit table for the full mapping. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <!-- Phase 5: needed for PopupThumbResizeBehavior/UIElementDropBehavior - Avalonia's own
         equivalent of Microsoft.Xaml.Behaviors (the package WPF's Behavior<T> classes came from).
         Same Phase-2-Ribbon-shaped trap: the original package ID (`Avalonia.Xaml.Interactivity`,
         last published 11.3.0.6) *restores and compiles* fine here, but throws
         System.TypeLoadException ("ResourcesChangedEventArgs ... due to value type mismatch") the
         moment a behavior is actually attached at runtime - confirmed by actually running it, not
         just building. Its author (wieslawsoltes/Xaml.Behaviors) republished the same
         `Avalonia.Xaml.Interactivity.Behavior<T>`/`Interaction` API under a new package ID,
         `Xaml.Behaviors.Interactivity`, for the Avalonia 12.x line (12.0.5 depends on Avalonia
         12.0.5) - confirmed via a real headless run to actually attach/detach/fire behaviors
         without error against 12.1.1. Same `Avalonia.Xaml.Interactivity` namespace, so no code
         changes were needed beyond this package reference. -->
    <PackageReference Include="Xaml.Behaviors.Interactivity" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kapok.View.Wpf's icon PNGs (Resources/Icons/*.png), copied in as-is - WPF's pack://
         URIs can't be resolved from here (they point at Kapok.View.Wpf's own embedded resources,
         and this module takes no dependency on that assembly), so the assets themselves are
         duplicated into this module and re-exposed via Avalonia's avares:// scheme instead. See
         ImageNameToImageSourceConverter.cs. -->
    <AvaloniaResource Include="Resources\Icons\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- kapok-fwk's own projects started multi-targeting net6.0/net8.0/net10.0 externally to
         this port (not a change made here) - without SetTargetFramework, MSBuild's
         ProjectReference negotiation didn't reliably pick the one TFM this net8.0-only project
         can actually build against, and failed hard on net10.0 (not installed on this machine).
         Pinning explicitly to net8.0 is the standard fix for a single-TFM project referencing a
         multi-targeted one, and doesn't require kapok-fwk itself to change. -->
    <ProjectReference Include="..\..\..\kapok-fwk\src\Kapok.Acl\Kapok.Acl.csproj" SetTargetFramework="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\..\kapok-fwk\src\Kapok.Core\Kapok.Core.csproj" SetTargetFramework="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\..\kapok-fwk\src\Kapok.Report\Kapok.Report.csproj" SetTargetFramework="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\..\kapok-fwk\src\Kapok.View\Kapok.View.csproj" SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
